# Express API (public blog, contact, admin mutations)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase — used only for /admin (Auth login + session JWT).
# The anon key is safe in the browser; RLS restricts what it can access.
# Public pages do not call Supabase directly — they use the API above.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
