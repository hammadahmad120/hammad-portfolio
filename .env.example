# Public URL of the deployed site. Used for metadata, sitemap.xml and robots.txt.
# On Vercel this can be left unset; VERCEL_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (optional).
# When BOTH values are set, /contact renders the form and POST /api/contact
# sends the message by email through Resend (https://resend.com).
# When either is missing, /contact shows only the mailto link.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com

# Sender address. Must belong to a domain verified in Resend.
# Defaults to "Portfolio <onboarding@resend.dev>", Resend's test sender,
# which only delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
